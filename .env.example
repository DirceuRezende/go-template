# Copie para .env (cp .env.example .env). O .env não é versionado; o go run ./cmd/api o carrega.
# Variável já definida no ambiente vence o arquivo.

# dev: segredo JWT de dev + admin admin@example.com / admin12345
APP_ENV=dev
# Obrigatório fora de dev, >= 32 bytes (gere com: openssl rand -hex 32)
# JWT_SECRET=

HTTP_ADDR=:8080
DATABASE_URL=postgres://users:users@localhost:5432/users?sslmode=disable
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ACCESS_TTL=15m
REFRESH_TTL=168h
OUTBOX_POLL_INTERVAL=1s

OTEL_SERVICE_NAME=user-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# none desliga, console imprime
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
